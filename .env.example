# ============================================================
# 环境变量样例 —— 复制为 .env 后按需填写
#     copy .env.example .env
# 所有 *_PROVIDER 都支持 auto|真实实现|mock 三态：
#     auto = 有 Key 走真实调用，无 Key 自动降级 Mock（接口契约不变，全流程照样跑通）
# 因此「拿到 Key 只改这个文件」即可切换到真实服务，无需改任何代码。
# ============================================================

# ---------- 语音服务选择 ----------
# VOICE_PROVIDER = auto | iflytek | baidu | mock
#   auto（默认）：优先讯飞（填了下面三项讯飞 Key）→ 退百度 → 都没有则 Mock
#   讯飞和百度只需配其中一家，接口契约完全相同，前端无感知
VOICE_PROVIDER=auto
# 单次语音请求超时（秒），讯飞 WebSocket 与百度的连接/等待共用
VOICE_TIMEOUT=20

# ---------- 科大讯飞 · 方言识别大模型（推荐）----------
# 一个 accent=mulacc 的模型覆盖 202 种方言，八大方言免切换识别 —— 这是它的主要优势。
# 控制台：https://console.xfyun.cn/  → 创建应用 → 开通「语音听写（方言大模型）」
# 注意：三项必须来自**同一个应用**，混用会返回 10313。
IFLYTEK_APPID=
IFLYTEK_API_KEY=
IFLYTEK_API_SECRET=
# 发音人（vcn）按方言在 configs/dialect.yaml 里配；
# 若某方言返回 11200（功能未授权），说明该发音人未在控制台开通，改那处配置即可。
IFLYTEK_TTS_SPEED=50
IFLYTEK_TTS_VOLUME=50
IFLYTEK_TTS_PITCH=50

# ---------- 百度智能云 · 多方言语音（任务 3.1 / 3.2，备用）----------
# 百度 REST 只有普通话/粤语/四川话三个方言模型，其余回退普通话；不填则不用它
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
# 语音识别采样率，百度短语音识别固定支持 16000 / 8000
BAIDU_ASR_RATE=16000
# 农业专业词库（任务 3.2）自训练平台模型 lm_id，留空则用内置词表做纠错后处理
BAIDU_LM_ID=
# TTS 语速(0-9) / 音量(0-15) / 音调(0-9)
BAIDU_TTS_SPD=5
BAIDU_TTS_VOL=5
BAIDU_TTS_PIT=5

# ---------- 大模型 · DeepSeek（OpenAI 兼容，任务 3.3）----------
# auto 时：填了 DEEPSEEK_API_KEY 就走真实调用，否则走规则化 Mock 报告
LLM_PROVIDER=auto
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT=60

# ---------- 农业 RAG 知识库（任务 4.4）----------
# auto 时：向量库存在且依赖可用就走真实检索，否则返回空 sources，流程不中断
RAG_ENABLED=auto
RAG_EMBEDDING_MODEL=shibing624/text2vec-base-chinese
# 向量模型 / timm 预训练权重的下载源。
# 国内直连 huggingface.co 会超时（实测 HEAD 请求 WinError 10060），默认走镜像；
# 境外部署改成 https://huggingface.co 即可。
HF_ENDPOINT=https://hf-mirror.com
# 禁用 HuggingFace 的 Xet 存储后端：其域名 cas-bridge.xethub.hf.co 在国内不通，
# 开着会在超时里反复重试（表现为下载卡在 "Trying to resume download..."）。
HF_HUB_DISABLE_XET=1
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=4

# ---------- 演示账号 ----------
# 初始化数据库时自动预置一个普通演示账号 user / nihao123（含三块示例田）。
# 它是普通账号，不绕过登录校验；账号已存在时不会覆盖。
# 不希望保留该公开账号时设为 off。
DEMO_SEED_ACCOUNT=on

# ---------- 服务运行时 ----------
HOST=127.0.0.1
PORT=8000
# 默认方言 key，取值见 configs/dialect.yaml（mandarin/cantonese/sichuan/...）
DIAGNOSE_DEFAULT_DIALECT=mandarin
# top1 置信度低于该值时接口返回 low_confidence=true
CONFIDENCE_THRESHOLD=0.45
# 上传文件大小上限（MB）
MAX_UPLOAD_MB=20
LOG_LEVEL=INFO
